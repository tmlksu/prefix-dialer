<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 回線(SIM)の一覧と表示名の取得。設定画面で回線ごとの ON/OFF を出すためだけに使う。
         プレフィックスを付けるかどうかの判定には不要（onPlaceCall が PhoneAccountHandle を直接渡すため）。 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 通話履歴まわりの権限とサービスは github フレーバーにのみ存在する。
         Google Play は、既定の電話アプリでないアプリが CALL_LOG 権限を
         マニフェストに宣言すること自体を禁じているため。
         app/src/github/AndroidManifest.xml を参照。 -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrefixDialer">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 発信直前に番号を書き換えるサービス -->
        <service
            android:name=".PrefixRedirectionService"
            android:exported="true"
            android:permission="android.permission.BIND_CALL_REDIRECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallRedirectionService" />
            </intent-filter>
        </service>

    </application>
</manifest>

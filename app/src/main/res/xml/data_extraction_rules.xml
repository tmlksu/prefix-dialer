<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12（API 31）以降用バックアップ除外設定。API 29–30 用は backup_rules.xml を参照。
  <cloud-backup>（Google アカウントへの自動バックアップ）と <device-transfer>（機種変更時の転送）
  の両方で発信記録を除外する。片方だけではもう片方に番号が流れるため、両方が要る。

  なぜ発信記録だけ除外するか:
  - PRIVACY.md は「発信した電話番号そのものである発信記録は端末内にのみ保存する」と約束しているため、
    自動バックアップや機種変更時の転送へ発信記録を送らない。
  - 設定（ルール・プレフィックスなど）は機種変で引き継ぐ価値があるため、バックアップ対象に残す。
  - 除外番号（実在しうる電話番号）が設定側に含まれることは承知の上。設定を引き継ぐ利便を優先し、
    その旨は PRIVACY.md に明記している。

  sharedpref ドメインの path はファイル名（`.xml` 付き）で指定する。
  https://developer.android.com/identity/data/autobackup 「Include and exclude files」参照。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="prefix_dialer_call_records.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="prefix_dialer_call_records.xml" />
    </device-transfer>
</data-extraction-rules>

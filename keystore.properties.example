# リリース署名の設定。このファイルを keystore.properties としてコピーし、値を埋める。
# keystore.properties と keystore 本体はリポジトリに含めないこと（.gitignore 済み）。
#
# 鍵の作成:
#   keytool -genkeypair -v -keystore release.keystore -alias prefixdialer \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# 作成した keystore を紛失すると、Play にアップロード済みのアプリを二度と更新
# できなくなる。必ず安全な場所にバックアップすること。

storeFile=release.keystore
storePassword=
keyAlias=prefixdialer
keyPassword=
